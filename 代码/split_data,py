import os
import shutil #Python自带的“操作系统",处理文件路径、创建文件夹、遍历文件列表

# 1. 源文件夹（下载解压出来的 PetImages）定义一个变量 source_dir
source_dir = "PetImages" 

# 2. 目标文件夹（PyTorch 需要的结构）定义目标路径 target_dir ./代表当前目录
target_dir = "./data/train"

# 3. 自动创建空文件夹
os.makedirs(os.path.join(target_dir, "cat"), exist_ok=True)
# os.makedirs(...)：创建文件夹  os.path.join(target_dir, "cat")：把路径拼起来，变成 ./data/train/cat
os.makedirs(os.path.join(target_dir, "dog"), exist_ok=True) # 防错参数

count_cat = 0
count_dog = 0 #准备两个计数器，分别记录复制了多少张猫图和狗图
print("开始分拣图片，请稍候...")

# 4. 分拣猫
cat_src = os.path.join(source_dir, "Cat") #猫的源路径是 PetImages/Cat
if os.path.exists(cat_src): # 检查是否存在
    for f in os.listdir(cat_src):  # 列出文件夹里所有文件的名字,循环遍历每一个文件名,把当前文件名赋值给变量f
        if f.endswith('.jpg'):   # 检查文件后缀是不是 .jpg---过滤掉可能存在的缓存文件、损坏文件或非图片文件  
            shutil.copy(os.path.join(cat_src, f), os.path.join(target_dir, "cat", f))
            # 把这个文件复制一份过去 shutil.copy(从哪, 到哪)
            count_cat += 1 #成功复制一张,计数器加一

# 5. 分拣狗 同上
dog_src = os.path.join(source_dir, "Dog")
if os.path.exists(dog_src):
    for f in os.listdir(dog_src):
        if f.endswith('.jpg'):
            shutil.copy(os.path.join(dog_src, f), os.path.join(target_dir, "dog", f))
            count_dog += 1

print(f"分拣完成！猫: {count_cat} 张，狗: {count_dog} 张。")
print(f"数据已经准备好在 {target_dir} 下！")